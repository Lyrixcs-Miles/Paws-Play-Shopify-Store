<section><div class="container two-col">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '360, 540, 800, 1100, 1600', sizes: '(max-width: 600px) 100vw, 50vw', class: 'about-img', loading: 'lazy' }}{% else %}<img src="{{ 'editorial-14.jpg' | asset_url }}" alt="Dog enjoying time outdoors" class="about-img" width="1000" height="1000" loading="lazy">{% endif %}<div><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.link != blank %}<a class="btn btn-brand" href="{{ section.settings.link }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div></div></section>
{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Caring for pets like family"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Content",
      "default": "<p>Thoughtfully chosen essentials for happier, healthier pets. Share your story and what makes your store special.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore our shop"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
