<div class="container"><article class="article"><p class="date">{{ article.published_at | date: format: 'date' }}</p><h1>{{ article.title | escape }}</h1>{% if article.image %}{{ article.image | image_url: width: 1400 | image_tag: widths: '400, 700, 1000, 1400', sizes: '(max-width: 800px) 100vw, 800px', class: 'article-photo', loading: 'eager', fetchpriority: 'high' }}{% endif %}<div class="rte">{{ article.content }}</div><a class="more" href="{{ blog.url }}">← {{ 'general.back_to_blog' | t }}</a></article></div><script type="application/ld+json">{{ article | structured_data }}</script>
{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
