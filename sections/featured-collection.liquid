<section id="Arrivals-{{ section.id }}"><div class="container featured-container"><div class="center"><span class="tag">{{ section.settings.eyebrow | escape }}</span></div><h2 class="section-title">{{ section.settings.heading | escape }}</h2><div class="product-grid">{% if section.settings.collection != blank %}{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}<p>{{ 'general.no_products_in_this_collection_yet' | t }}</p>{% endfor %}{% else %}{% assign previews = 'bed.svg,toy.svg,cushion-bed.svg,ceramic-bowl.svg,bowl.svg,rope-lead.svg,collar.svg,steel-bowl.svg' | split: ',' %}{% for preview in previews limit: section.settings.limit %}<article class="product preview-product"><div class="img"><img src="{{ preview | asset_url }}" alt="{{ 'general.pet_product_preview' | t }}" class="product-art" width="300" height="260" loading="lazy"></div><h3>{{ 'general.pet_essentials' | t }}</h3></article>{% endfor %}{% endif %}</div><div class="center-btn"><a class="btn btn-brand" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a></div></div></section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Made for happy pets"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Latest Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore all products"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
