<section><div class="container password-content"><a class="logo" href="{{ routes.root_url }}">{% render 'brand' %}</a><h1>{{ section.settings.heading | escape }}</h1><div class="rte">{{ shop.password_message }}</div>{% form 'storefront_password', class: 'contact-form' %}{{ form.errors | default_errors }}<label for="StorePassword">{{ 'general.store_password' | t }}</label><input id="StorePassword" type="password" name="password" autocomplete="current-password" required><button class="btn btn-brand" type="submit">{{ 'general.enter_store' | t }}</button>{% endform %}</div></section>
{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good things are coming for your pets"
    }
  ]
}
{% endschema %}
