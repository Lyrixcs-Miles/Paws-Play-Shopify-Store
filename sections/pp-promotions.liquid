<div class="pp-section-shell color-{{ section.settings.color_scheme }} gradient"><section class="pp-promotions-section"><div class="pp-container pp-promo-grid">{% for block in section.blocks %}<div class="pp-promo" {{ block.shopify_attributes }}><span class="pp-promo-word" aria-hidden="true">{{ block.settings.word | escape }}</span>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 | image_tag: class: 'pp-editorial-photo', loading: 'lazy' }}{% else %}{% if forloop.first %}<img src="{{ 'pp-cat.jpg' | asset_url }}" alt="Ginger cat" class="pp-editorial-photo" width="1000" height="1000" loading="lazy">{% else %}<img src="{{ 'pp-dog.jpg' | asset_url }}" alt="Golden retriever" class="pp-editorial-photo" width="1000" height="1000" loading="lazy">{% endif %}{% endif %}<div class="pp-promo-overlay"><div><span class="pp-tag">{{ block.settings.label | escape }}</span><h2>{{ block.settings.title | escape }}</h2></div><a href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ 'paws_play.explore_products' | t }} →</a></div></div>{% endfor %}</div></section>
</div>
{% schema %}
{
  "name": "Paws: banners",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "word",
          "label": "Background word",
          "default": "new"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Small label",
          "default": "Home away from home"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "New collection of beds"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Paws: banners",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "title": "New Collection of Beds",
            "word": "new"
          }
        },
        {
          "type": "banner",
          "settings": {
            "title": "Premium Walking Accessories",
            "label": "Active lifestyle",
            "word": "play"
          }
        }
      ]
    }
  ]
}
{% endschema %}
