<div class="pp-section-shell color-{{ section.settings.color_scheme | default: 'scheme-1' }} gradient">
  <section class="pp-promotions-section">
    <div class="pp-container pp-promo-grid">
      {% for block in section.blocks %}
        <article class="pp-promo" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '400, 600, 900, 1200, 1600', sizes: '(max-width: 749px) calc(100vw - 32px), (max-width: 1532px) 48vw, 742px', class: 'pp-editorial-photo', loading: 'lazy' }}
          {% elsif forloop.first %}
            <img src="{{ 'pp-promo-kittens-bed-v1.png' | asset_url }}" alt="Two fluffy gray kittens in a brown fleece-lined pet bed" class="pp-editorial-photo" width="1254" height="1254" loading="lazy">
          {% else %}
            <img src="{{ 'pp-promo-retriever-collar-v1.png' | asset_url }}" alt="Golden retriever wearing an olive walking collar" class="pp-editorial-photo" width="1254" height="1254" loading="lazy">
          {% endif %}
          {% if block.settings.word != blank %}<span class="pp-promo-word" aria-hidden="true">{{ block.settings.word | escape }}</span>{% endif %}
          <div class="pp-promo-overlay">
            <div class="pp-promo-copy">{% if block.settings.label != blank %}<span class="pp-tag">{{ block.settings.label | escape }}</span>{% endif %}<h2>{{ block.settings.title | escape }}</h2></div>
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="pp-promo-link">{{ 'paws_play.explore_products' | t }} <span aria-hidden="true">&#8594;</span></a>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "Paws: banners",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "word",
          "label": "Background word",
          "default": "new"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Small label",
          "default": "Home away from home"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "New collection of beds"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Paws: banners",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "title": "New Collection of Beds",
            "word": "new"
          }
        },
        {
          "type": "banner",
          "settings": {
            "title": "Premium Walking Accessories",
            "label": "Active lifestyle",
            "word": "play"
          }
        }
      ]
    }
  ]
}
{% endschema %}
