<div class="page-hero"><h1>{{ 'general.your_cart' | t }}</h1></div><section><div class="container cart-container">{% if cart.empty? %}<div class="empty-state"><p>{{ 'general.your_cart_is_empty' | t }}</p><a class="btn btn-brand" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></div>{% else %}{% form 'cart', cart, class: 'cart-form' %}<div class="cart-items">{% for item in cart.items %}<article class="cart-item"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: class: 'cart-image', loading: 'lazy' }}{% endif %}</a><div><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% unless property.last == blank or first_character == '_' %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endunless %}{% endfor %}{% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}<a class="remove-link" href="{{ item.url_to_remove }}">{{ 'general.remove' | t }}</a></div><label class="cart-quantity">{{ 'general.quantity' | t }}<input type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="{{ item.variant.quantity_rule.increment | default: 1 }}" aria-label="{{ 'general.quantity_for' | t: product: item.product.title | escape }}"></label><div>{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}<strong>{{ item.final_line_price | money }}</strong></div></article>{% endfor %}</div><div class="cart-summary"><label for="CartNote">{{ 'general.order_note' | t }}</label><textarea id="CartNote" name="note">{{ cart.note | escape }}</textarea>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<h2>{{ 'general.subtotal' | t }} {{ cart.total_price | money_with_currency }}</h2><p>{{ 'general.shipping_and_taxes_calculated_at_checkout' | t }}</p><div class="cart-actions"><button class="btn" name="update" type="submit">{{ 'general.update_cart' | t }}</button><button class="btn btn-brand" type="submit" name="checkout">{{ 'general.checkout' | t }}</button></div></div>{% endform %}{% endif %}</div></section>
{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
