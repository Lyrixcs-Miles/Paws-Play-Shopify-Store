<div class="pp-section-shell color-{{ section.settings.color_scheme }} gradient"><section><div class="pp-container"><div class="pp-center"><span class="pp-tag">{{ section.settings.eyebrow | escape }}</span></div><h2 class="pp-section-title">{{ section.settings.heading | escape }}</h2><div class="pp-cat-grid">{% for block in section.blocks %}{% assign destination = block.settings.link | default: block.settings.collection.url | default: routes.all_products_collection_url %}<a class="pp-cat" href="{{ destination }}" {{ block.shopify_attributes }}><h3>{{ block.settings.title | escape }}</h3>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 500 | image_tag: class: 'pp-category-art', loading: 'lazy' }}{% elsif block.settings.collection.featured_image != blank %}{{ block.settings.collection.featured_image | image_url: width: 500 | image_tag: class: 'pp-category-art', loading: 'lazy' }}{% else %}{% assign art = forloop.index0 | modulo: 4 %}{% case art %}{% when 0 %}<img src="{{ 'pp-category-bed-v1.png' | asset_url }}" alt="Taupe and cream plush pet bed" class="pp-category-art" width="1000" height="1000" loading="lazy">{% when 1 %}<img src="{{ 'pp-category-toys-v1.png' | asset_url }}" alt="Pet toy" class="pp-category-art" width="1000" height="1000" loading="lazy">{% when 2 %}<img src="{{ 'pp-category-walk-v1.png' | asset_url }}" alt="Walking accessories" class="pp-category-art" width="1000" height="1000" loading="lazy">{% else %}<img src="{{ 'pp-category-supplies-v1.png' | asset_url }}" alt="Pet grooming brush and mitt" class="pp-category-art" width="1000" height="1000" loading="lazy">{% endcase %}{% endif %}</a>{% endfor %}</div></div></section>
</div>
{% schema %}
{
  "name": "Paws: categories",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Made for happy pets"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pet supplies"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Paws: categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Beds & comfort"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Toys for pets"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Walking accessories"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Pet supplies"
          }
        }
      ]
    }
  ]
}
{% endschema %}
