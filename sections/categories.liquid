<section><div class="container"><div class="center"><span class="tag">{{ section.settings.eyebrow | escape }}</span></div><h2 class="section-title">{{ section.settings.heading | escape }}</h2><div class="cat-grid">{% for block in section.blocks %}{% assign destination = block.settings.link | default: block.settings.collection.url | default: routes.all_products_collection_url %}<a class="cat" href="{{ destination }}" {{ block.shopify_attributes }}><h3>{{ block.settings.title | escape }}</h3>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 500 | image_tag: class: 'category-art', loading: 'lazy' }}{% elsif block.settings.collection.featured_image != blank %}{{ block.settings.collection.featured_image | image_url: width: 500 | image_tag: class: 'category-art', loading: 'lazy' }}{% else %}{% assign art = forloop.index0 | modulo: 4 %}{% case art %}{% when 0 %}<img src="{{ 'kibble.svg' | asset_url }}" alt="Pet food" class="category-art" width="1000" height="1000" loading="lazy">{% when 1 %}<img src="{{ 'toy-ball.svg' | asset_url }}" alt="Pet toy" class="category-art" width="1000" height="1000" loading="lazy">{% when 2 %}<img src="{{ 'category-walk.svg' | asset_url }}" alt="Walking accessories" class="category-art" width="1000" height="1000" loading="lazy">{% else %}<img src="{{ 'category-bed.svg' | asset_url }}" alt="Pet bed" class="category-art" width="1000" height="1000" loading="lazy">{% endcase %}{% endif %}</a>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Shop by category",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Made for happy pets"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pet supplies"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Dry & wet food"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Toys for pets"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Walking accessories"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Pet supplies"
          }
        }
      ]
    }
  ]
}
{% endschema %}
