<header class="site-header"><div class="topbar"><span>{{ section.settings.phone | escape }}</span><span>{{ section.settings.hours | escape }}</span></div>
<nav class="nav" aria-label="{{ 'general.main_navigation' | t }}"><a class="logo" href="{{ routes.root_url }}">{% render 'brand' %}</a>
<button class="menu-toggle" type="button" data-menu-toggle aria-controls="Menu-{{ section.id }}" aria-label="{{ 'general.open_menu' | t }}" aria-expanded="false">☰</button>
<div class="menu" id="Menu-{{ section.id }}" data-menu>
{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}{% if link.links != blank %}<details class="dropdown"><summary class="dropdown-toggle">{{ link.title | escape }} ▾</summary><div class="dropdown-menu">{% for child in link.links %}<a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>{% if child.links != blank %}{% for grandchild in child.links %}<a class="menu-grandchild" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>{% endfor %}{% endif %}{% endfor %}</div></details>{% else %}<a href="{{ link.url }}"{% if link.current %} class="active" aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}{% endfor %}
{% else %}<a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a>{% endif %}</div>
<div class="nav-right"><a class="search-link" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}">⌕</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" aria-label="{{ 'general.account' | t }}">♙</a>{% endif %}<a class="cart-link" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}">♧<span class="badge">{{ cart.item_count }}</span></a>{% if section.settings.button_url != blank %}<a class="btn btn-brand btn-sm" href="{{ section.settings.button_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div></nav></header>
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Opening hours",
      "default": "Mon–Sat: 9am–7pm"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get in touch"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ]
}
{% endschema %}
