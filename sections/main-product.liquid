<section class="product-section"><div class="container"><nav class="crumbs" aria-label="{{ 'general.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> / <a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a> / {{ product.title | escape }}</nav><div class="product-detail" id="Product-{{ section.id }}" data-product-section="{{ section.id }}"><div class="gallery">{% assign selected_variant = product.selected_or_first_available_variant %}{% assign selected_media = selected_variant.featured_media | default: product.featured_media %}<div class="main-img">{% if selected_media %}{% render 'product-media', media: selected_media, eager: true %}{% else %}{{ 'product-1' | placeholder_svg_tag: 'product-art' }}{% endif %}</div>{% if product.media.size > 1 %}<div class="product-gallery">{% for media in product.media %}{% unless media.id == selected_media.id %}<details><summary>{{ 'general.view_media' | t }} {{ forloop.index }}</summary>{% render 'product-media', media: media %}</details>{% endunless %}{% endfor %}</div>{% endif %}</div><div class="info"><p class="product-vendor">{{ product.vendor | escape }}</p><h1>{{ product.title | escape }}</h1><div class="big-price">{{ selected_variant.price | money }}{% if selected_variant.compare_at_price > selected_variant.price %} <s>{{ selected_variant.compare_at_price | money }}</s>{% endif %}</div>{% unless product.has_only_default_variant %}<form method="get" action="{{ product.url }}" class="variant-form" data-variant-form>{% for option in product.options_with_values %}<fieldset><legend>{{ option.name | escape }}</legend><select name="option_values" data-option-select aria-label="{{ option.name | escape }}">{% for value in option.values %}<option value="{{ value.id }}" data-product-url="{{ value.product_url }}"{% if value.selected %} selected{% endif %}>{{ value | escape }}</option>{% endfor %}</select></fieldset>{% endfor %}<button type="submit" class="btn">{{ 'general.update_selection' | t }}</button></form>{% endunless %}
{% assign product_form_id = 'ProductForm-' | append: section.id %}{% form 'product', product, id: product_form_id, class: 'product-form' %}{{ form.errors | default_errors }}<input type="hidden" name="id" value="{{ selected_variant.id }}"><label for="Quantity-{{ section.id }}">{{ 'general.quantity' | t }}</label><div class="qty-row"><input class="quantity-input" id="Quantity-{{ section.id }}" name="quantity" type="number" value="{{ selected_variant.quantity_rule.min | default: 1 }}" min="{{ selected_variant.quantity_rule.min | default: 1 }}" step="{{ selected_variant.quantity_rule.increment | default: 1 }}"{% if selected_variant.quantity_rule.max %} max="{{ selected_variant.quantity_rule.max }}"{% endif %}><button type="submit" class="btn btn-brand"{% unless selected_variant.available %} disabled{% endunless %}>{% if selected_variant.available %}{{ 'general.add_to_cart' | t }}{% else %}{{ 'general.sold_out' | t }}{% endif %}</button></div>{% if section.settings.dynamic_checkout and selected_variant.available %}{{ form | payment_button }}{% endif %}{% endform %}<div class="rte product-description">{{ product.description }}</div>{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% when 'detail' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}</summary><div class="rte">{{ block.settings.text }}</div></details>{% endcase %}{% endfor %}</div></div></div></section><script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Product details",
  "settings": [
    {
      "type": "checkbox",
      "id": "dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "detail",
      "name": "Information panel",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Delivery and returns"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Content",
          "default": "<p>Add your delivery and returns policy here.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
