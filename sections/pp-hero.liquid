<div class="pp-section-shell color-{{ section.settings.color_scheme }} gradient" style="--pp-hero-background:{{ section.settings.background }}"><section class="pp-hero"><div class="pp-hero-big" aria-hidden="true">{{ section.settings.background_text | escape }}</div><div class="pp-container pp-hero-grid"><div class="pp-hero-text"><p>{{ section.settings.intro | escape }}</p><h1>{{ section.settings.heading | escape }}<br><span>{{ section.settings.subheading | escape }}</span></h1><div class="pp-hero-buttons"><a class="pp-btn" href="{{ section.settings.primary_url | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }}</a><a class="pp-btn" href="{{ section.settings.secondary_url | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label | escape }}</a></div></div><div class="pp-hero-visual"><div class="pp-main pp-hero-dogs">
{% if section.settings.husky != blank %}{{ section.settings.husky | image_url: width: 1600 | image_tag: widths: '360, 540, 800, 1100, 1600', sizes: '(max-width: 600px) 100vw, 50vw', class: 'pp-hero-husky', loading: 'eager', fetchpriority: 'high' }}{% else %}<img src="{{ 'pp-hero-husky.png' | asset_url }}" alt="Blue-eyed husky" class="pp-hero-husky" width="1000" height="1000" loading="eager" fetchpriority="high">{% endif %}
{% if section.settings.puppy != blank %}{{ section.settings.puppy | image_url: width: 1600 | image_tag: widths: '360, 540, 800, 1100, 1600', sizes: '(max-width: 600px) 100vw, 50vw', class: 'pp-hero-tiny-puppy', loading: 'eager', fetchpriority: 'high' }}{% else %}<img src="{{ 'pp-tiny-puppy.png' | asset_url }}" alt="Fluffy white puppy wearing a pink bandana" class="pp-hero-tiny-puppy" width="1000" height="1000" loading="eager" fetchpriority="high">{% endif %}
</div><div class="pp-hero-cards">{% for block in section.blocks %}<div class="pp-hero-card-wrapper" {{ block.shopify_attributes }}>{% if block.settings.product != blank %}{% render 'pp-product-card', product: block.settings.product %}{% else %}<a class="pp-hero-card pp-hero-preview" href="{{ routes.all_products_collection_url }}">{% if forloop.first %}<img src="{{ 'pp-hero-bowl.svg' | asset_url }}" alt="Stainless steel pet bowl" class="pp-hero-product" width="1000" height="1000" loading="lazy">{% else %}<img src="{{ 'pp-leash.svg' | asset_url }}" alt="Retractable leash" class="pp-hero-product" width="1000" height="1000" loading="lazy">{% endif %}<h3>{{ block.settings.label | escape }}</h3><span>{{ 'paws_play.explore_the_shop' | t }} →</span></a>{% endif %}</div>{% endfor %}</div></div></div></section>
</div>
{% schema %}
{
  "name": "Paws: two dog hero",
  "settings": [
    {
      "type": "text",
      "id": "background_text",
      "label": "Background lettering",
      "default": "pet store"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Introduction",
      "default": "Our mission is simple: to help pets live healthier, happier lives while making pet care easier and enjoyable for their families."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The Ultimate Pet"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Second line",
      "default": "Shopping Destination"
    },
    {
      "type": "image_picker",
      "id": "husky",
      "label": "Large dog image"
    },
    {
      "type": "image_picker",
      "id": "puppy",
      "label": "Small dog image"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "First button label",
      "default": "New arrivals"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Second button label",
      "default": "All products"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Second button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hero background",
      "default": "#d9d9d8"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Featured product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Preview label",
          "default": "Pet essentials"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Paws: two dog hero",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "label": "Metal bowl"
          }
        },
        {
          "type": "product",
          "settings": {
            "label": "The leash"
          }
        }
      ]
    }
  ]
}
{% endschema %}
