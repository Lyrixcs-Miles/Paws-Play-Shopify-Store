<section class="testimonials"><div class="container"><div class="center"><span class="tag">{{ section.settings.eyebrow | escape }}</span></div><h2 class="section-title">{{ section.settings.heading | escape }}</h2><div class="testi-grid">{% for block in section.blocks %}<div class="testi-card" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: class: 'care-photo', loading: 'lazy' }}{% else %}{% case forloop.index %}{% when 1 %}<img src="{{ 'editorial-1.jpg' | asset_url }}" alt="Dog relaxing" class="care-photo" width="1000" height="1000" loading="lazy">{% when 2 %}<img src="{{ 'editorial-2.jpg' | asset_url }}" alt="Cat at home" class="care-photo" width="1000" height="1000" loading="lazy">{% else %}<img src="{{ 'dog-natural.jpg' | asset_url }}" alt="Happy beagle" class="care-photo" width="1000" height="1000" loading="lazy">{% endcase %}{% endif %}<div class="body"><div class="testi-tags"><span>{{ block.settings.tag | escape }}</span></div><h3>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>{% else %}{{ block.settings.title | escape }}{% endif %}</h3></div></div>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Pet care cards",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Made for happy pets"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by Pet Owners Who Want the Very Best"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Care card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Care & wellness"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pet wellness"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Pet care cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Pet Nutrition"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Cat Essentials"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Pet Wellness"
          }
        }
      ]
    }
  ]
}
{% endschema %}
