<section data-recommendations="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&amp;product_id={{ product.id }}&amp;limit=4&amp;intent=related"{% unless recommendations.performed? and recommendations.products_count > 0 %} hidden{% endunless %}><div class="container"><h2 class="section-title">{{ section.settings.heading | escape }}</h2><div class="product-grid">{% for recommendation in recommendations.products %}{% render 'product-card', product: recommendation %}{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    }
  ],
  "presets": [
    {
      "name": "Related products"
    }
  ]
}
{% endschema %}
