{% doc %}
  Renders a collection directory card with a curated product photograph.
  @param {collection} collection - Collection to link to
{% enddoc %}
{%- capture preview_asset -%}
  {%- case collection.handle -%}
    {%- when 'grooming-bath' -%}pp-preview-rubber-grooming-bath-brush-v1.png
    {%- when 'health-hygiene' -%}pp-preview-pet-oral-spray-for-cats-dogs-60-ml-v1.png
    {%- when 'home-comfort' -%}pp-preview-magic-mesh-pet-safety-gate-v1.png
    {%- when 'travel-car' -%}pp-preview-waterproof-pet-car-seat-cover-v1.png
    {%- when 'cats' -%}pp-preview-litter-deodorising-beads-v1.png
    {%- when 'dogs' -%}pp-preview-reflective-dog-leash-set-v1.png
  {%- endcase -%}
{%- endcapture -%}
<a class="pp-directory-card" href="{{ collection.url }}">
  <div class="pp-directory-card__image{% if collection.handle == 'dogs' %} pp-directory-card__image--lifestyle{% endif %}">
    {%- if preview_asset != blank -%}
      <img
        src="{{ preview_asset | asset_img_url: '720x' }}"
        srcset="{{ preview_asset | asset_img_url: '360x' }} 360w, {{ preview_asset | asset_img_url: '540x' }} 540w, {{ preview_asset | asset_img_url: '720x' }} 720w"
        sizes="(min-width: 990px) 380px, (min-width: 750px) 45vw, 46vw"
        width="720" height="720" loading="lazy" alt="{{ collection.title | escape }}"
      >
    {%- elsif collection.featured_image -%}
      {{ collection.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 990px) 380px, 46vw', alt: collection.title }}
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="pp-directory-card__caption">
    <h2>{{ collection.title | escape }}</h2>
    <span class="pp-directory-card__arrow" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
  </div>
</a>
