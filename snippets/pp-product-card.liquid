{% doc %}
Renders a compact product preview inside the Paws hero.
@param {product} product - Featured product
{% enddoc %}
{% if product != blank %}<article class="pp-hero-card"><a href="{{ product.url }}"><div class="pp-hero-product">{% capture hero_product_art %}{% render 'pp-product-preview-asset', product: product %}{% endcapture %}{% assign hero_product_art = hero_product_art | strip %}{% if hero_product_art != blank %}<img src="{{ hero_product_art | asset_img_url: '500x' }}" alt="{{ product.title | escape }}" width="1254" height="1254" loading="eager">{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 500 | image_tag: widths: '180, 300, 500', sizes: '15vw', loading: 'eager' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div><h3>{{ product.title | escape }}</h3><div class="pp-price">{% if product.price_varies %}{{ 'paws_play.from' | t }} {% endif %}{{ product.price | money }}</div>{% unless product.available %}<span>{{ 'products.product.sold_out' | t }}</span>{% endunless %}</a></article>{% endif %}
